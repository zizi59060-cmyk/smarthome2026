<?xml version="1.0"?>
<package format="3">
  <name>smarthome_comm</name>
  <version>0.1.0</version>
  <description>Unified upper-lower computer communication package for smart-home sorting robot.</description>
  <maintainer email="you@example.com">smarthome team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>smarthome_common_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
